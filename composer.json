{
    "name": "endurance/workout",
    "description": "Immutable workout prescriptions with typed targets and bounded repeat occurrence reads",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "endurance/foundation": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Endurance\\Workout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Endurance\\Workout\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "example": "@php examples/intervals.php",
        "check": [
            "@composer validate --strict",
            "@test",
            "@example"
        ]
    }
}
